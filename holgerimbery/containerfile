FROM ruby:3.4

RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && apt-get clean
RUN python3 -m venv /opt/image-env
ENV PATH="/opt/image-env/bin:$PATH"

WORKDIR /site

COPY requirements-images.txt /tools/requirements-images.txt
RUN python -m pip install --no-cache-dir -r /tools/requirements-images.txt
COPY scripts/optimize_images.py /tools/optimize_images.py

COPY holgerimbery/Gemfile holgerimbery/Gemfile.lock ./
RUN bundle install

COPY holgerimbery/ ./

EXPOSE 4000

CMD ["sh", "-c", "python /tools/optimize_images.py --source /site && bundle exec jekyll serve --host 0.0.0.0 --port 4000 --livereload --future"]