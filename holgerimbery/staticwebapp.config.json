{
    "routes": [
      {
        "route": "/images/generated/*",
        "headers": {
          "Cache-Control": "public, max-age=31536000, immutable"
        }
      },
      {
        "route": "/impressum",
        "redirect": "https://instruo365.de/impressum/",
        "statusCode": 301
      },
      {
        "route": "/impressum/",
        "redirect": "https://instruo365.de/impressum/",
        "statusCode": 301
      }
    ],
    "responseOverrides": {
      "404": {
        "rewrite": "/404.html"
      }
    }
  }